package scanner

import (
	"os"
	"path/filepath"
	"testing"
)

// BenchmarkScan1KLOC benchmarks scanning a 1K LOC codebase
func BenchmarkScan1KLOC(b *testing.B) {
	tempDir := setupBenchmarkCodebase(b, 1000)
	defer os.RemoveAll(tempDir)

	config := &Config{
		Scanners: []string{"bandit"},
		Path:     tempDir,
		Output:   "json",
	}

	db := setupBenchmarkDB(b)
	defer db.Close()

	orch, err := NewOrchestrator(config, db)
	if err != nil {
		b.Fatalf("Failed to create orchestrator: %v", err)
	}

	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		_, err := orch.Scan()
		if err != nil {
			b.Fatalf("Scan failed: %v", err)
		}
	}
}

