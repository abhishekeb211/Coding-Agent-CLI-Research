package storage

import (
	"os"
	"testing"
)

// BenchmarkFindingInsertion benchmarks inserting findings into database
func BenchmarkFindingInsertion(b *testing.B) {
	db := setupBenchDB(b)
	defer db.Close()

	finding := Finding{
		ID:          "test-finding",
		RuleID:      "test-rule",
		Severity:    "high",
		CWE:         "CWE-89",
		Description: "Test finding",
		FilePath:    "test.py",
		LineNumber:  42,
		RunID:       "test-run",
	}

	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		finding.ID = "finding-" + string(rune(i))
		err := db.InsertFinding(finding)
		if err != nil {
			b.Fatalf("Failed to insert finding: %v", err)
		}
	}
}

// BenchmarkFindingRetrievalByID benchmarks retrieving a finding by ID
func BenchmarkFindingRetrievalByID(b *testing.B) {
	db := setupBenchDB(b)
	defer db.Close()

	// Insert test findings
	for i := 0; i < 1000; i++ {
		finding := Finding{
			ID:       "finding-" + string(rune(i)),
			RuleID:   "rule-1",
			Severity: "high",
			RunID:    "run-1",
		}
		db.InsertFinding(finding)
	}

	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		_, err := db.GetFindingByID("finding-500")
		if err != nil {
			b.Fatalf("Failed to retrieve finding: %v", err)
		}
	}
}

// BenchmarkFindingQueryWithFilters benchmarks querying findings with filters
func BenchmarkFindingQueryWithFilters(b *testing.B) {
	db := setupBenchDB(b)
	defer db.Close()

	// Insert test findings
	for i := 0; i < 10000; i++ {
		finding := Finding{
			ID:       "finding-" + string(rune(i)),
			RuleID:   "rule-" + string(rune(i%10)),
			Severity: []string{"low", "medium", "high", "critical"}[i%4],
			CWE:      "CWE-" + string(rune(i%100)),
			RunID:    "run-1",
		}
		db.InsertFinding(finding)
	}

	filters := FindingFilters{
		Severity: "high",
		CWE:      "CWE-89",
	}

	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		_, err := db.QueryFindings(filters)
		if err != nil {
			b.Fatalf("Failed to query findings: %v", err)
		}
	}
}

// BenchmarkDatabase1KFindings benchmarks database operations with 1K findings
func BenchmarkDatabase1KFindings(b *testing.B) {
	db := setupBenchDB(b)
	defer db.Close()

	findings := generateFindings(1000)

	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		for _, f := range findings {
			db.InsertFinding(f)
		}
	}
}

