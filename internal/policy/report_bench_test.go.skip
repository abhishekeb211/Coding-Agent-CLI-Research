package policy

import (
	"os"
	"path/filepath"
	"testing"
)

// BenchmarkJSONReportGeneration benchmarks JSON report generation
func BenchmarkJSONReportGeneration(b *testing.B) {
	findings := generateBenchFindings(1000)
	tempDir := setupBenchDir(b)
	defer os.RemoveAll(tempDir)

	reportPath := filepath.Join(tempDir, "report.json")

	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		err := GenerateJSONReport(findings, reportPath)
		if err != nil {
			b.Fatalf("Failed to generate JSON report: %v", err)
		}
	}
}

