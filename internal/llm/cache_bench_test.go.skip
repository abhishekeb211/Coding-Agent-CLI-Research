// BenchmarkCacheWithLargeEntries benchmarks cache with large entries
func BenchmarkCacheWithLargeEntries(b *testing.B) {
	cache := setupBenchCache(b)
	defer cache.Close()

	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		key := "key-" + string(rune(i))
		value := generateLargeRemediation(1000) // 1000 words
