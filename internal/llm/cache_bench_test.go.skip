package llm

import (
	"os"
	"testing"
)

// BenchmarkCacheLookup benchmarks cache lookup performance
func BenchmarkCacheLookup(b *testing.B) {
	cache := setupBenchCache(b)
	defer cache.Close()

	// Populate cache
	for i := 0; i < 1000; i++ {
		key := "key-" + string(rune(i))
		value := "remediation for finding " + string(rune(i))
		cache.Set(key, value)
	}

	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		_, _ = cache.Get("key-500")
	}
}

// BenchmarkCacheStorage benchmarks cache storage performance
func BenchmarkCacheStorage(b *testing.B) {
	cache := setupBenchCache(b)
	defer cache.Close()

	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		key := "key-" + string(rune(i))
		value := "remediation for finding " + string(rune(i))
		err := cache.Set(key, value)
		if err != nil {
			b.Fatalf("Failed to set cache: %v", err)
		}
	}
}

// BenchmarkCacheHitRate measures cache hit rate with repeated findings
func BenchmarkCacheHitRate(b *testing.B) {
	cache := setupBenchCache(b)
	defer cache.Close()

	// Populate cache with 100 entries
	for i := 0; i < 100; i++ {
		key := "key-" + string(rune(i))
		value := "remediation " + string(rune(i))
		cache.Set(key, value)
	}

	hits := 0
	misses := 0

	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		// 70% of requests hit cache (keys 0-69)
		// 30% of requests miss cache (keys 100-129)
		var key string
		if i%10 < 7 {
			key = "key-" + string(rune(i%70))
		} else {
			key = "key-" + string(rune(100+i%30))
		}

		_, found := cache.Get(key)
		if found {
			hits++
		} else {
			misses++
		}
	}

	hitRate := float64(hits) / float64(hits+misses) * 100
	b.ReportMetric(hitRate, "hit_rate_%")
}

// BenchmarkCacheMemoryUsage measures cache memory usage
func BenchmarkCacheMemoryUsage(b *testing.B) {
	cache := setupBenchCache(b)
	defer cache.Close()

	b.ReportAllocs()
	b.ResetTimer()
	for i := 0; i < b.N; i++ {
		key := "key-" + string(rune(i))
		value := generateLargeRemediation(500) // 500 words
		cache.Set(key, value)
	}
}

